{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Releases are the owner's (ADR-0004 in Oneirico/ProjectTemplate): agents open draft PRs, never merge, tag or release.",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run release-gate)",
      "Bash(npm run validate)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh release:*)",
      "Bash(gh api:*)",
      "Bash(git tag:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./security-reviews/**)",
      "Write(./security-reviews/**)"
    ]
  }
}
